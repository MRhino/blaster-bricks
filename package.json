{
  "name": "blaster-bricks",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "bot": "node --experimental-strip-types --no-warnings scripts/bot.ts",
    "challenges": "node --experimental-strip-types --no-warnings scripts/challenges.ts",
    "test": "node --experimental-strip-types --no-warnings scripts/test-meta.ts && node --experimental-strip-types --no-warnings scripts/test-sim.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0"
  },
  "overrides": {
    "@vercel/cli-config": "0.3.8",
    "zod": "^4.6.6"
  }
}
